-- LOGIC & RARITY DETERMINATION
---------------------------------------------------------
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function isInsidePlotOrRanch(obj)
    local lowName = string.lower(obj.Name)
    if string.find(lowName, "plot") or string.find(lowName, "farm") or string.find(lowName, "ranch") or string.find(lowName, "garden") then
        return true
    end
    if obj:GetAttribute("Owner") or obj:GetAttribute("PlantedBy") or obj:GetAttribute("RanchOwner") then
        return true
    end
    return false
end

local function getEggRarity(obj, nameDisplay)
    local attrRarity = obj:GetAttribute("Rarity") or (obj:FindFirstChild("Rarity") and obj.Rarity.Value)
    if attrRarity and type(attrRarity) == "string" and attrRarity ~= "" then
        for _, r in ipairs(RARITY_ORDER) do
            if string.lower(attrRarity) == string.lower(r) then
                return r
            end
        end
        return attrRarity
    end

    local cleanName = string.lower(nameDisplay)
    if EGG_RARITY_DATABASE[cleanName] then
        return EGG_RARITY_DATABASE[cleanName]
    end

    if string.find(cleanName, "ethereal") or string.find(cleanName, "cherub") or string.find(cleanName, "blackhole") or string.find(cleanName, "black hole") or string.find(cleanName, "solaris") then
        return "Ethereal"
    elseif string.find(cleanName, "divine") or string.find(cleanName, "aurora") or string.find(cleanName, "galaxy") or string.find(cleanName, "angelic") then
        return "Divine"
    elseif string.find(cleanName, "mythic") or string.find(cleanName, "crystal") or string.find(cleanName, "skull") or string.find(cleanName, "dominus") or string.find(cleanName, "flaming") or string.find(cleanName, "sinister") or string.find(cleanName, "soul") then
        return "Mythic"
    elseif string.find(cleanName, "legendary") or string.find(cleanName, "glass") or string.find(cleanName, "golden") or string.find(cleanName, "dragon") or string.find(cleanName, "phoenix") then
        return "Legendary"
    elseif string.find(cleanName, "epic") or string.find(cleanName, "mushroom") or string.find(cleanName, "flower") or string.find(cleanName, "slime") or string.find(cleanName, "ice") or string.find(cleanName, "dino") then
        return "Epic"
    elseif string.find(cleanName, "rare") or string.find(cleanName, "cracked") or string.find(cleanName, "easter") or string.find(cleanName, "stone") or string.find(cleanName, "leaf") or string.find(cleanName, "ocean") then
        return "Rare"
    elseif string.find(cleanName, "uncommon") or string.find(cleanName, "forest") then
        return "Uncommon"
    elseif string.find(cleanName, "common") or string.find(cleanName, "starter") or string.find(cleanName, "basic") then
        return "Common"
    elseif string.find(cleanName, "secret") then
        return "Secret"
    end

    return "Other"
end

