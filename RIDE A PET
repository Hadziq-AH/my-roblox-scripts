-- TRACKING & REFRESH LOGIC (AUTO REFRESH ENHANCED)
---------------------------------------------------------
local function rebuildTrackedList()
    trackedEggsList = {}
    for _, data in pairs(trackedEggsMap) do
        table.insert(trackedEggsList, data)
    end
    eggCountLabel.Text = "Eggs Detected: " .. tostring(#trackedEggsList)
end

local function updateDropdownButtonText()
    if #trackedEggsList == 0 then
        eggDropdownBtn.Text = "[SELECTED EGG: 0 / 0]\nNo Eggs Detected ▼"
        selectedEggIndex = 1
    else
        if selectedEggIndex > #trackedEggsList then selectedEggIndex = #trackedEggsList end
        if selectedEggIndex < 1 then selectedEggIndex = 1 end
        
        local current = trackedEggsList[selectedEggIndex]
        local distStr = ""
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and current and current.Part then
            local dist = math.floor((hrp.Position - current.Part.Position).Magnitude)
            distStr = " (" .. dist .. "m)"
        end

        if current then
            eggDropdownBtn.Text = string.format("[SELECTED EGG: %d / %d]\n%s [%s]%s ▼", selectedEggIndex, #trackedEggsList, current.Name, current.Rarity, distStr)
        end
    end
end

local function rebuildDropdownList()
    for _, child in ipairs(DropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for i, eggData in ipairs(trackedEggsList) do
        local distStr = ""
        if hrp and eggData.Part then
            local dist = math.floor((hrp.Position - eggData.Part.Position).Magnitude)
            distStr = " (" .. dist .. "m)"
        end

        local itemBtn = Instance.new("TextButton")
        itemBtn.BackgroundColor3 = (i == selectedEggIndex) and Color3.fromRGB(255, 190, 40) or Color3.fromRGB(25, 28, 38)
        itemBtn.Text = string.format("#%d %s\n[%s]%s", i, eggData.Name, eggData.Rarity, distStr)
        itemBtn.TextColor3 = (i == selectedEggIndex) and Color3.fromRGB(18, 20, 26) or (RARITY_COLORS[eggData.Rarity] or Color3.fromRGB(255, 255, 255))
        itemBtn.TextSize = 8.5
        itemBtn.Font = Enum.Font.GothamBold
        itemBtn.LineHeight = 1.1
        itemBtn.ZIndex = 11
        itemBtn.Parent = DropdownList

        local itemCorner = Instance.new("UICorner")
        itemCorner.CornerRadius = UDim.new(0, 6)
        itemCorner.Parent = itemBtn

        itemBtn.MouseButton1Click:Connect(function()
            selectedEggIndex = i
            updateDropdownButtonText()
            DropdownList.Visible = false
        end)
    end

    local rowCount = math.ceil(#trackedEggsList / 2)
    DropdownList.CanvasSize = UDim2.new(0, 0, 0, rowCount * 40 + 6)
end

local function checkAndAddEgg(obj)
    if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then return end
    if isInsidePlotOrRanch(obj) then return end

    local lowName = string.lower(obj.Name)
    if string.find(lowName, "egg") or string.find(lowName, "blackhole") then
        local rootObj = obj
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and obj.Parent ~= Workspace then
            rootObj = obj.Parent
        end

        if isInsidePlotOrRanch(rootObj) then return end
        if trackedEggsMap[rootObj] then return end

        local targetPart = rootObj:IsA("Model") and (rootObj.PrimaryPart or rootObj:FindFirstChildWhichIsA("BasePart", true)) or (rootObj:IsA("BasePart") and rootObj)
        if not targetPart then return end

        local nameDisplay = rootObj.Name
        if nameDisplay == "Model" or nameDisplay == "Part" or nameDisplay == "BasePart" then nameDisplay = obj.Name end

        local eggRarity = getEggRarity(rootObj, nameDisplay)

        if enabledRarities[eggRarity] == true then
            local rarityColor = RARITY_COLORS[eggRarity] or Color3.fromRGB(255, 255, 255)

            local bb = Instance.new("BillboardGui")
            bb.Name = "TenshinEggBB"
            bb.Adornee = targetPart
            bb.Size = UDim2.new(0, 140, 0, 38)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent = targetPart

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = nameDisplay .. "\n[" .. eggRarity .. "]"
            txt.TextColor3 = rarityColor
            txt.TextStrokeTransparency = 0.2
            txt.TextSize = 10
            txt.Font = Enum.Font.GothamBold
            txt.Parent = bb

            trackedEggsMap[rootObj] = {
                Root = rootObj,
                Part = targetPart,
                Name = nameDisplay,
                Rarity = eggRarity,
                Billboard = bb,
                TextLabel = txt
            }
            rebuildTrackedList()
            updateDropdownButtonText()
            if DropdownList.Visible then rebuildDropdownList() end
        end
    end
end

local function removeEggESP()
    for root, data in pairs(trackedEggsMap) do
        if data.Billboard then data.Billboard:Destroy() end
    end
    trackedEggsMap = {}
    rebuildTrackedList()
    
    if espUpdateThread then
        task.cancel(espUpdateThread)
        espUpdateThread = nil
    end
    updateDropdownButtonText()
end

local function scanWorkspaceForEggs()
    for _, obj in ipairs(Workspace:GetChildren()) do
        checkAndAddEgg(obj)
        if obj:IsA("Model") or obj:IsA("Folder") then
            for _, child in ipairs(obj:GetChildren()) do
                checkAndAddEgg(child)
            end
        end
    end
end

local function applyEggESP()
    removeEggESP()
    scanWorkspaceForEggs()

    if not espUpdateThread then
        espUpdateThread = task.spawn(function()
            local autoScanTimer = 0
            while isEggESP do
                -- 1. Auto Scan Workspace Every 2 Seconds for New Eggs
                autoScanTimer = autoScanTimer + 1
                if autoScanTimer >= 2 then
                    autoScanTimer = 0
                    scanWorkspaceForEggs()
                end

                -- 2. Clean Removed/Taken Eggs & Update Distances
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local isChanged = false

                for root, data in pairs(trackedEggsMap) do
                    if not root.Parent or not data.Part.Parent then
                        if data.Billboard then data.Billboard:Destroy() end
                        trackedEggsMap[root] = nil
                        isChanged = true
                    elseif hrp then
                        local dist = math.floor((hrp.Position - data.Part.Position).Magnitude)
                        data.TextLabel.Text = data.Name .. "\n[" .. data.Rarity .. " - " .. dist .. "m]"
                    end
                end

                if isChanged then
                    rebuildTrackedList()
                end

                -- 3. Live Sync UI Text & Active Dropdown Grid
                updateDropdownButtonText()
                if DropdownList.Visible then
                    rebuildDropdownList()
                end

                task.wait(1.0)
            end
        end)
    end
end

local function toggleEggESP(state)
    isEggESP = state
    if isEggESP then
        eggEspBtn.Text = "EGG ESP : ON"
        eggEspBtn.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
        eggEspBtn.TextColor3 = Color3.fromRGB(18, 20, 26)
        applyEggESP()
    else
        eggEspBtn.Text = "EGG ESP : OFF"
        eggEspBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
        eggEspBtn.TextColor3 = Color3.fromRGB(180, 185, 200)
        removeEggESP()
    end
end

