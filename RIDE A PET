-- TELEPORT SYSTEM
---------------------------------------------------------
local function safeTeleport(targetCFrame)
    local char = getCharacter()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

    if bodyVelocity then bodyVelocity.Velocity = Vector3.new(0, 0, 0) end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    hrp.CFrame = targetCFrame * CFrame.new(0, 4.5, 0)

    task.wait(0.05)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

local function teleportToSelectedEgg()
    if #trackedEggsList == 0 then return end
    if selectedEggIndex > #trackedEggsList then selectedEggIndex = 1 end
    
    local target = trackedEggsList[selectedEggIndex]
    if target and target.Part then
        safeTeleport(target.Part.CFrame)
    end
end

local function teleportToGearShop()
    local targetCFrame = nil
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pText = string.lower(prompt.ActionText .. " " .. prompt.ObjectText)
            if string.find(pText, "gear") or string.find(pText, "tool") or string.find(pText, "shop") then
                local parentPart = prompt.Parent
                if parentPart and parentPart:IsA("BasePart") then targetCFrame = parentPart.CFrame break
                elseif parentPart and parentPart:IsA("Model") then targetCFrame = parentPart:GetPivot() break end
            end
        end
    end

    if targetCFrame then
        safeTeleport(targetCFrame)
    else
        warn("[Tenshin Hub] Lokasi Gear Shop tidak ditemukan.")
    end
end

