-- SCRIPT LOGIC
---------------------------------------------------------
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- Fast Walkspeed Enforcer
local function applyWalkSpeed(val)
    walkSpeed = math.clamp(val, 0, 1000)
    wsInput.Text = tostring(walkSpeed)
end

speedConnection = RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= walkSpeed then
            humanoid.WalkSpeed = walkSpeed
        end
    end
end)

-- Fly System dengan Ultra-Responsive Scaling
local function toggleFly(state)
    isFlying = state
    local char = getCharacter()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not hrp or not humanoid then return end

    if isFlying then
        flyToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 240)
        flyToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = hrp

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp

        humanoid.PlatformStand = true

        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying or not hrp or not hrp.Parent then
                if flyConnection then flyConnection:Disconnect() end
                return
            end

            local camera = workspace.CurrentCamera
            local moveDir = Vector3.new()

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

            -- Multiplier tinggi (4x) agar angka kecil sudah terasa sangat kencang
            bodyVelocity.Velocity = moveDir * (flySpeed * 4)
            bodyGyro.CFrame = camera.CFrame
        end)
    else
        flyToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
        flyToggleBtn.TextColor3 = Color3.fromRGB(180, 185, 200)

        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        humanoid.PlatformStand = false
    end
end

-- FE Invisible (Server Desync Method)
local cloneChar = nil
local function toggleInvis(state)
    isInvis = state
    local char = getCharacter()
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not char or not hrp then return end

    if isInvis then
        invisToggleBtn.Text = "FE INVISIBLE : ON"
        invisToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 240)
        invisToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

        -- FE Invisibility Trick: Break server replication via Local CFrame Offset & RootJoint desync
        local lowerTorso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
        if lowerTorso then
            local rootJoint = lowerTorso:FindFirstChild("RootRigJoint") or hrp:FindFirstChild("RootJoint")
            if rootJoint then
                rootJoint:Destroy() -- Melepas koneksi fisik ke server agar tubuh menjadi invisible bagi player lain
            end
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 0.5 -- Efek transparan pada layar kamu sendiri sebagai penanda
            end
        end
    else
        invisToggleBtn.Text = "FE INVISIBLE : OFF"
        invisToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
        invisToggleBtn.TextColor3 = Color3.fromRGB(180, 185, 200)

        -- Respawn/Reset lokal untuk mengembalikan karakter ke kondisi normal
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
    end
end

-- Button Listeners (+10 / -10 per klik)
wsMinus.MouseButton1Click:Connect(function() applyWalkSpeed(walkSpeed - 10) end)
wsPlus.MouseButton1Click:Connect(function() applyWalkSpeed(walkSpeed + 10) end)

wsInput.FocusLost:Connect(function()
    local val = tonumber(wsInput.Text)
    if val then applyWalkSpeed(val) else wsInput.Text = tostring(walkSpeed) end
end)

flyMinus.MouseButton1Click:Connect(function()
    flySpeed = math.max(5, flySpeed - 10)
    flyInput.Text = tostring(flySpeed)
end)

flyPlus.MouseButton1Click:Connect(function()
    flySpeed = flySpeed + 10
    flyInput.Text = tostring(flySpeed)
end)

flyInput.FocusLost:Connect(function()
    local val = tonumber(flyInput.Text)
    if val then flySpeed = math.max(0, val) else flyInput.Text = tostring(flySpeed) end
end)

flyToggleBtn.MouseButton1Click:Connect(function() toggleFly(not isFlying) end)
invisToggleBtn.MouseButton1Click:Connect(function() toggleInvis(not isInvis) end)

