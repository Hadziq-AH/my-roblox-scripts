-- SCRIPT LOGIC
---------------------------------------------------------
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- Helper: Get list of all other players in map
local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

-- Helper: Search Player by Username or DisplayName
local function findPlayer(str)
    str = string.lower(str)
    if str == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), str) or string.find(string.lower(p.DisplayName), str) then
                return p
            end
        end
    end
    return nil
end

-- Speed Enforcer
local function applyWalkSpeed(val)
    walkSpeed = math.clamp(val, 0, 1000)
    wsInput.Text = tostring(walkSpeed)
end

speedConnection = RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= walkSpeed then
            humanoid.WalkSpeed = walkSpeed
        end
    end
end)

-- Fly System
local function toggleFly(state)
    isFlying = state
    local char = getCharacter()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not hrp or not humanoid then return end

    if isFlying then
        flyToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 240)
        flyToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = hrp

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp

        humanoid.PlatformStand = true

        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying or not hrp or not hrp.Parent then
                if flyConnection then flyConnection:Disconnect() end
                return
            end

            local camera = workspace.CurrentCamera
            local moveDir = Vector3.new()

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

            bodyVelocity.Velocity = moveDir * (flySpeed * 4)
            bodyGyro.CFrame = camera.CFrame
        end)
    else
        flyToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
        flyToggleBtn.TextColor3 = Color3.fromRGB(180, 185, 200)

        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        humanoid.PlatformStand = false
    end
end

-- Spectate Core Functions
local function setSpectateTarget(target)
    if target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") then
        isSpectating = true
        spectateTarget = target
        specBtn.Text = "UNSPECTATE"
        specBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 240)
        specBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        targetInput.Text = target.Name

        workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid")
    end
end

local function stopSpectate()
    isSpectating = false
    spectateTarget = nil
    specBtn.Text = "SPECTATE"
    specBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
    specBtn.TextColor3 = Color3.fromRGB(180, 185, 200)

    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        workspace.CurrentCamera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
    end
end

local function toggleSpectate()
    if isSpectating then
        stopSpectate()
    else
        local target = findPlayer(targetInput.Text)
        local otherPlayers = getOtherPlayers()

        if target then
            for i, p in ipairs(otherPlayers) do
                if p == target then
                    currentSpecIndex = i
                    break
                end
            end
            setSpectateTarget(target)
        elseif #otherPlayers > 0 then
            if currentSpecIndex > #otherPlayers then currentSpecIndex = 1 end
            setSpectateTarget(otherPlayers[currentSpecIndex])
        end
    end
end

local function cycleSpectate(direction)
    local otherPlayers = getOtherPlayers()
    if #otherPlayers == 0 then return end

    if not isSpectating then
        currentSpecIndex = 1
    else
        currentSpecIndex = currentSpecIndex + direction
        if currentSpecIndex > #otherPlayers then
            currentSpecIndex = 1
        elseif currentSpecIndex < 1 then
            currentSpecIndex = #otherPlayers
        end
    end

    setSpectateTarget(otherPlayers[currentSpecIndex])
end

RunService.RenderStepped:Connect(function()
    if isSpectating then
        if spectateTarget and spectateTarget.Parent and spectateTarget.Character and spectateTarget.Character:FindFirstChildOfClass("Humanoid") then
            workspace.CurrentCamera.CameraSubject = spectateTarget.Character:FindFirstChildOfClass("Humanoid")
        else
            stopSpectate()
        end
    end
end)

-- Teleport System
local function teleportToTarget()
    local target = findPlayer(targetInput.Text) or spectateTarget
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = getCharacter()
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
end

---------------------------------------------------------
-- ESP CORE FUNCTIONS
---------------------------------------------------------
local function applyESP(player)
    if player == LocalPlayer then return end

    local function createHighlight(char)
        if not char then return end
        local old = char:FindFirstChild("TenshinESP")
        if old then old:Destroy() end

        local highlight = Instance.new("Highlight")
        highlight.Name = "TenshinESP"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(255, 60, 60)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Parent = char
    end

    if player.Character then
        createHighlight(player.Character)
    end

    espConnections[player] = player.CharacterAdded:Connect(function(char)
        if isESP then
            task.wait(0.2)
            createHighlight(char)
        end
    end)
end

local function removeESP(player)
    if espConnections[player] then
        espConnections[player]:Disconnect()
        espConnections[player] = nil
    end
    if player.Character then
        local hl = player.Character:FindFirstChild("TenshinESP")
        if hl then hl:Destroy() end
    end
end

local function toggleESP(state)
    isESP = state
    if isESP then
        espBtn.Text = "ESP PLAYER : ON"
        espBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 240)
        espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

        for _, p in ipairs(Players:GetPlayers()) do
            applyESP(p)
        end
    else
        espBtn.Text = "ESP PLAYER : OFF"
        espBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 42)
        espBtn.TextColor3 = Color3.fromRGB(180, 185, 200)

        for _, p in ipairs(Players:GetPlayers()) do
            removeESP(p)
        end
    end
end

-- ESP Listener for new players joining/leaving
Players.PlayerAdded:Connect(function(p)
    if isESP then
        applyESP(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
end)

